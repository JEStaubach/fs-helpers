#!/usr/bin/env sh
set -eu

if ! command -v detect-secrets >/dev/null 2>&1; then
    echo "Error: required system command 'detect-secrets' is not installed." >&2
    exit 1
fi

# The optional word list relies on pyahocorasick in the system Python environment.
if [ -f wordlist.txt ]; then
    if ! command -v python >/dev/null 2>&1; then
        echo "Error: wordlist.txt requires Python and pyahocorasick, but 'python' is not installed." >&2
        echo "Install Python and run: python -m pip install pyahocorasick" >&2
        exit 1
    fi
    if ! python -c "import ahocorasick" >/dev/null 2>&1; then
        echo "Error: wordlist.txt requires pyahocorasick in the system Python environment." >&2
        echo "Install it with: python -m pip install pyahocorasick" >&2
        exit 1
    fi

    scan_output=$(detect-secrets scan --no-verify --word-list wordlist.txt --string "$(cat "$1")")
else
    scan_output=$(detect-secrets scan --no-verify --string "$(cat "$1")")
fi

# A detector match makes the commit fail; do not hide matching plugins.
matches=$(printf '%s\n' "$scan_output" | grep -E ':[[:space:]]*True([[:space:]]+\([^)]*\))?[[:space:]]*$' || true)
if [ -n "$matches" ]; then
    echo "Suspected secret in commit message:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi

npx --no-install commitlint --edit "$1"
