{
  "name": "@jestaubach/fs-helpers",
  "version": "0.2.31",
  "type": "module",
  "main": "./dist/fs-helpers.umd.cjs",
  "module": "./dist/fs-helpers.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fs-helpers.js",
      "require": "./dist/fs-helpers.umd.cjs"
    }
  },
  "description": "wrapper around fs-extra",
  "keywords": [],
  "homepage": "https://github.com/JEStaubach/fs-helpers",
  "bugs": {
    "url": "https://github.com/JEStaubach/fs-helpers/issues",
    "email": "contact@jsdevtools.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JEStaubach/fs-helpers.git"
  },
  "contributors": [
    {
      "name": "JEStaubach",
      "email": "justin@jsdevtools.com",
      "url": "https://twitter.com/jsdevtool"
    }
  ],
  "license": "MIT",
  "private": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "commit": "commit",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "test": "vitest run --coverage --reporter dot && npm run test:package",
    "test:package": "npm run build && node --test __tests__/package-exports.smoke.mjs"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "builtin-modules": "^5.4.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
